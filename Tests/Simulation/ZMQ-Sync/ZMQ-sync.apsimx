                  "Units": null,
                  "Name": "SoilWaterEffect",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "\nNo effect of soil water content on root growth is currently captured in the model.\n",
